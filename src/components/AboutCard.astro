---
interface Props {
  title: string;
  description: string;
  company: string;
  phone: string;
}

const { title, description, company, phone } = Astro.props;
---

<article class="card">
  <h2>{title}</h2>
  <p>{description}</p>
  <p class="subtitle">{company}</p>
  <p class="phone">{phone}</p>
</article>
