---
interface Props {
  title: string;
  items: string[];
  background?: boolean;
}

const { title, items, background = false } = Astro.props;
---

<article class:list={["card", { "card--bg": background }]}>
  <h3>{title}</h3>
  <ul>
    {
      items.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>
</article>
